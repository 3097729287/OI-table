{
  "productName": "OI-table",
  "version": "0.1.0",
  "identifier": "com.oi-table.desktop",
  "build": {
    "beforeDevCommand": "npm run icon && npm run dev",
    "devUrl": "http://127.0.0.1:11420",
    "beforeBuildCommand": "npm run icon && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OI-table",
        "width": 920,
        "height": 620,
        "minWidth": 360,
        "minHeight": 400,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' ws://127.0.0.1:11420"
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
